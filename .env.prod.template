# Copy to /opt/slouka/production.env on VPS, mode 0600. Never commit real values.
COMPOSE_PROJECT_NAME=slouka
APP_ENV_FILE=./production.env
BACKEND_IMAGE=ghcr.io/sloukaapp/backend@sha256:REPLACE_WITH_PUBLISHED_DIGEST
ACME_EMAIL=REPLACE_WITH_MONITORED_EMAIL
APP__ALLOWED_ORIGINS='[]'
DB__USER=slouka
DB__PASSWORD=REPLACE_WITH_RANDOM_URL_SAFE_PASSWORD
DB__NAME=slouka
DB__DSN=postgresql+asyncpg://slouka:REPLACE_WITH_RANDOM_URL_SAFE_PASSWORD@database:5432/slouka
# For URL-special credentials set DB__CONTAINER_DSN with percent-encoded credentials.
REDIS__DSN=redis://redis:6379/0
AUTH__JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
SMTP__PASSWORD=REPLACE_WITH_NOREPLY_MAILBOX_PASSWORD
ROUNDCUBEMAIL_DES_KEY=REPLACE_WITH_24_CHAR_KEY

# Verbum search (same defaults as development)
VERBUM__URL=https://verbum.by/api/search
VERBUM__DICTIONARY_IDS='["tsblm2022","tsbm","klyshka","rbs10"]'
VERBUM__CONNECT_TIMEOUT_SECONDS=5
VERBUM__READ_TIMEOUT_SECONDS=10
VERBUM__MAX_RETRIES=2
CACHE__TTL_DAYS=30
RATE_LIMIT__SEARCH_WINDOW_SECONDS=60
RATE_LIMIT__SEARCH_MAX_REQUESTS=30
