# App
APP__ENV=development
APP__BASE_URL=http://localhost:8000
APP__ALLOWED_ORIGINS='["http://localhost:8000"]'
APP__TRUSTED_PROXIES='[]'

# Database (USER/PASSWORD/NAME are consumed by docker-compose only)
DB__USER=postgres
DB__PASSWORD=postgres
DB__NAME=slouka
DB__DSN=postgresql+asyncpg://postgres:postgres@localhost:5432/slouka
# Optional DB__CONTAINER_DSN: URL-encoded credentials, host database:5432 (Compose only)
DB__ECHO=false
DB__ECHO_POOL=false
DB__POOL_SIZE=10
DB__MAX_OVERFLOW=5
DB__POOL_PRE_PING=true
DB__POOL_TIMEOUT=30

# pgAdmin (dev Compose only; web UI on http://localhost:5050)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=
PGADMIN_PORT=5050

# Redis
REDIS__DSN=redis://localhost:6379/0
REDIS__KEY_PREFIX=slouka
REDIS__MAX_CONNECTIONS=10
REDIS__SOCKET_TIMEOUT=5

# Auth (access/refresh TTLs are fixed; active-device limit must be at least 5)
AUTH__JWT_SECRET=change-me-to-a-secure-random-secret-key
AUTH__JWT_ALGORITHM=HS256
AUTH__ACCESS_TOKEN_TTL_MINUTES=30
AUTH__REFRESH_TOKEN_TTL_DAYS=30
AUTH__MAX_ACTIVE_DEVICES=5
AUTH__CONFIRMATION_TTL_SECONDS=900
AUTH__CONFIRMATION_RESEND_COOLDOWN_SECONDS=60

# SMTP (Mailpit from compose, web UI on http://localhost:8025)
SMTP__HOST=localhost
SMTP__PORT=1025
SMTP__FROM_EMAIL=noreply@slouka.local
SMTP__USE_TLS=false
SMTP__START_TLS=false
SMTP__TIMEOUT_SECONDS=10
SMTP__MAX_RETRIES=2

# Upstream cache and outbound HTTP clients
CACHE__TTL_DAYS=30
HTTP__TIMEOUT_SECONDS=10
HTTP__MAX_RETRIES=3

# Sliding window counters (approximate)
RATE_LIMIT__LOGIN_WINDOW_SECONDS=900
RATE_LIMIT__LOGIN_MAX_ATTEMPTS=10
RATE_LIMIT__LOGIN_IP_WINDOW_SECONDS=60
RATE_LIMIT__LOGIN_IP_MAX_ATTEMPTS=60
RATE_LIMIT__CONFIRMATION_EMAIL_WINDOW_SECONDS=900
RATE_LIMIT__CONFIRMATION_EMAIL_MAX_ATTEMPTS=5
RATE_LIMIT__CONFIRMATION_IP_WINDOW_SECONDS=900
RATE_LIMIT__CONFIRMATION_IP_MAX_ATTEMPTS=20

# Logging
LOGGING__LEVEL=INFO
