# App
APP__ENV=development
APP__BASE_URL=http://localhost:8000
APP__ALLOWED_ORIGINS='["http://localhost:8000"]'
APP__TRUSTED_PROXIES='[]'

# Database (USER/PASSWORD/NAME are consumed by docker-compose only)
DB__USER=postgres
DB__PASSWORD=postgres
DB__NAME=slouka
DB__DSN=postgresql+asyncpg://postgres:postgres@localhost:5432/slouka
DB__ECHO=false
DB__ECHO_POOL=false
DB__POOL_SIZE=10
DB__MAX_OVERFLOW=5
DB__POOL_PRE_PING=true
DB__POOL_TIMEOUT=30

# Redis
REDIS__DSN=redis://localhost:6379/0
REDIS__KEY_PREFIX=slouka
REDIS__MAX_CONNECTIONS=10
REDIS__SOCKET_TIMEOUT=5

# Auth (TTLs and device limit are fixed by contract, config validation rejects other values)
AUTH__JWT_SECRET=change-me-to-a-secure-random-secret-key
AUTH__JWT_ALGORITHM=HS256
AUTH__ACCESS_TOKEN_TTL_MINUTES=30
AUTH__REFRESH_TOKEN_TTL_DAYS=30
AUTH__MAX_ACTIVE_DEVICES=5

# SMTP (Mailpit from compose, web UI on http://localhost:8025)
SMTP__HOST=localhost
SMTP__PORT=1025
SMTP__FROM_EMAIL=noreply@slouka.local
SMTP__USE_TLS=false

# Upstream cache and outbound HTTP clients
CACHE__TTL_DAYS=30
HTTP__TIMEOUT_SECONDS=10
HTTP__MAX_RETRIES=3

# Login rate limit (Redis sliding window)
RATE_LIMIT__LOGIN_WINDOW_SECONDS=300
RATE_LIMIT__LOGIN_MAX_ATTEMPTS=10

# Logging
LOGGING__LEVEL=INFO
